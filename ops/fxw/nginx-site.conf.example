# Example Nginx reverse proxy for an FXW/Linux staging server.
# Replace assistant.example.nl with the real staging domain.
# Configure TLS/HTTPS certificates on the real server, for example with your hosting tools or Certbot.
# This file contains no secrets.

server {
    listen 80;
    server_name assistant.example.nl;

    # In production/staging, redirect HTTP to HTTPS after certificates are configured.
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /health, /ready, /api/config, /api/chat, /widget/widget.js, and demo pages
        # are all proxied naturally through this block.
    }
}
